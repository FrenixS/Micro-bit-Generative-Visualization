radio.setGroup(1)

basic.forever(function () {
    // 1. Läs av accelerometern (tilt på X- och Y-axeln)
    let x = input.acceleration(Dimension.X)
    let y = input.acceleration(Dimension.Y)

    // 2. Kontrollera knapparna (0 = ingen, 1 = A, 2 = B, 3 = A+B)
    let btn = 0
    if (input.buttonIsPressed(Button.AB)) {
        btn = 3
    } else if (input.buttonIsPressed(Button.A)) {
        btn = 1
    } else if (input.buttonIsPressed(Button.B)) {
        btn = 2
    }

    // 3. Skicka datan över radio som en kommateckenseparerad textrad
    radio.sendString(x + "," + y + "," + btn)

    // Pausera 50 ms (~20 uppdateringar per sekund)
    basic.pause(50)
})
